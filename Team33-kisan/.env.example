# Groq (get key at https://console.groq.com/keys) - starts with gsk_
# Models are auto-detected. Optionally force one: GROQ_MODEL=...  GROQ_VISION_MODEL=...
GROQ_API_KEY=gsk_xxxx

# Optional: live mandi prices (free key at https://data.gov.in)
DATA_GOV_API_KEY=

# Optional: WhatsApp via Twilio (needed only to download photos sent on WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
