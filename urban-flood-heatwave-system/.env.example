# ============================================================
#  Urban Flood & Heatwave Early-Warning System — Environment
# ============================================================

# --- Backend ---
DEBUG=false
SECRET_KEY=change-me-in-production-secret-key-32chars

# OpenWeatherMap (get free key at openweathermap.org)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Gemini Vision (for citizen photo AI analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps (optional — OSRM public server used by default)
MAPS_API_KEY=

# Redis (optional — only needed for real-time WebSocket push)
REDIS_URL=redis://localhost:6379

# Alert thresholds (adjust per city)
FLOOD_RISK_THRESHOLD=0.6
HEATWAVE_TEMP_THRESHOLD=40.0
RAINFALL_HIGH_MM=50.0

# Forecast refresh interval in seconds (1800 = 30 min)
FORECAST_REFRESH_SECONDS=1800

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000/api
