# Sahaaya AI - Environment Configuration

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=replace_with_a_new_random_secret_key

# Database Configuration (Relative to project root or absolute)
DATABASE_URL=sqlite:///data/sahaaya.db

# Gemini API Configuration (via google-genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Retrieval Engine Configuration (sqlite_fts5 is primary zero-config fallback, faiss is secondary)
RETRIEVAL_BACKEND=sqlite_fts5
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Server Port
PORT=8000
HOST=127.0.0.1
